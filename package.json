{
  "name": "cwl-link",
  "version": "1.1.8",
  "description": "Create a CloudWatch Logs Link",
  "keywords": [
    "AWS",
    "CloudWatch Logs"
  ],
  "homepage": "https://github.com/michiharu/cwl-link",
  "bugs": {
    "url": "https://github.com/michiharu/cwl-link/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michiharu/cwl-link.git"
  },
  "author": "michiharu",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "main": "dist/cwl-link.cjs",
  "module": "dist/cwl-link.mjs",
  "types": "dist/cwl-link.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/cwl-link.d.ts",
        "default": "./dist/cwl-link.mjs"
      },
      "require": {
        "types": "./dist/cwl-link.d.cts",
        "default": "./dist/cwl-link.cjs"
      }
    }
  },
  "files": [
    "/dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "doc": "typedoc --plugin typedoc-plugin-markdown --out docs src/index.ts",
    "test": "jest"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.93",
    "@types/jest": "^27.4.1",
    "@types/node": "22.13.9",
    "esbuild": "^0.14.32",
    "esbuild-jest": "^0.5.0",
    "jest": "^27.5.1",
    "rollup": "^2.70.1",
    "rollup-plugin-dts": "^4.2.0",
    "rollup-plugin-esbuild": "^4.9.1",
    "typedoc": "0.27.9",
    "typedoc-plugin-markdown": "^3.12.0",
    "typescript": "5.8.2"
  }
}
